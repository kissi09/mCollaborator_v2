# Build artifacts
*.exe
*.exe~
backend/mCollaborator.exe
backend/mCollaborator.exe~
# Pre-rename binaries, so a leftover copy is never committed either
backend/stitch.exe
backend/stitch.exe~

# Generated reports — client deliverables, never commit these.
# They can contain real vulnerability findings and client names.
backend/backend/reports/
backend/reports/
*.docx.tmp

# Logs
*.log
mCollaborator-out.log
mCollaborator-err.log
stitch-out.log
stitch-err.log

# OS / cloud-sync noise
desktop.ini
Thumbs.db
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Live application state — a running server's database, its WAL, and the
# evidence files uploaded into it. Real engagement data, never source.
backend/data/
backend/*.pid

# Editor / pre-refactor backups kept locally
*.bak

# Client-facing deliverables kept alongside the docs. These are engagement
# output, not project source, and must not reach a remote.
docs/*.pptx
docs/*Closure Report*

# Desktop build output. build/bin is scratch; dist/ is the shipping set.
desktop/build/bin/
desktop/build/windows/installer/tmp/

# The shipping binaries are committed, by request, so the app can be downloaded
# straight from the repository rather than from a release. They are exempted
# from the blanket *.exe rule above.
#
# Worth knowing: git keeps every version of these forever, so each rebuild that
# is committed adds its full size to the history permanently and every clone
# pays for it. Roughly 38MB a build at present.
!desktop/dist/
!desktop/dist/*.exe
